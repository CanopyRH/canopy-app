# Copy to launch.env. The deploy command reads it. Addresses only, never a private key. Values here are Robinhood Chain's.
STABLE=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
STABLE_FEED=0x8bEeE3503F6860D5dac4cE26b5eEe92982951c2e
STABLE_FEED_HEARTBEAT=90000
# Watcher addresses, comma-separated, 2 to 16 and all different. Approved from the first block of the deploy for 365 days. The same
# list as "watchers" in settings.json. None may be a Safe above.
WATCHERS=
# Your Safe addresses. They must be two different multisigs.
PROPOSER_MULTISIG=
GUARDIAN_MULTISIG=
# Unix time, 12 months after deploy.
ADMIN_EXPIRY=
# New mainnet deployments require at least seven days (maximum thirty days).
# Admin and guardian Safes must have disjoint owners and thresholds of at least two.
TIMELOCK_DELAY=604800
# Used by the commands in RUNBOOK.md. Your private endpoint holds a key, and this file is git-ignored.
RPC=https://rpc.mainnet.chain.robinhood.com
# The deployer's address, from the keystore in deploy/mainnet/.
DEPLOYER=
