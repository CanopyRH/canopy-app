# Copy to watcher.env (private); inject keys from the host secret store.
# Use deploy/services.env.example separately for the indexer/detector chain.env.
ROLE=watcher
DATABASE_URL=postgres://canopy:CHANGE_ME@watcher-db:5432/canopy?sslmode=require
CHAIN_ID=4663
ALARM_BOOK=0x6A391f2c489dDFcb60Ad64eDddda5Ea0921584cf
RPC_URL=https://rpc.mainnet.chain.robinhood.com
WATCHER_PRIVATE_KEY=
ANTHROPIC_API_KEY=
WATCHERS=
WATCHER_PEERS=https://api.canopyrh.com
# Independently reviewed public HTTPS sources; exact source URLs must match approvals.
FEED_URLS=
# Copy the current listed vault addresses from services.env.example.
CARD_VAULTS=
WATCHER_APPROVAL_FILE=/run/canopy/report-approvals.json
WATCHER_REQUIRE_DIVERSITY=true
# Only quorum-submitting hosts need this protected file. A watcher-only host sends no chain transactions.
WATCHER_PROFILE_FILE=
