# Copy to launch.base.env (git-ignored). The Base deploy command reads it. Addresses only, never a private key.
# The same fields as launch.env, with Base values. Checked on a Base fork on 2026-11-06 (deploy/out/8453-rehearsal).
# Native USDC on Base, 6 decimals. It is also the plan token.
STABLE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WETH=0x4200000000000000000000000000000000000006
# Uniswap v3 SwapRouter02 on Base.
SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
# Chainlink USDC/USD on Base, 8 decimals. It updates at least every 24 hours (86400 s); 90000 leaves an hour of slack.
STABLE_FEED=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
STABLE_FEED_HEARTBEAT=90000
# Watcher addresses, comma-separated, 2 to 16 and all different. Approved from the first block of the deploy for 365 days. The same
# list as "watchers" in settings.base.json. None may be a Safe below. The Robinhood Chain watcher addresses can be reused: a
# signature names the chain and the AlarmBook, so it can't be replayed across chains.
WATCHERS=
# The Base Safes. They must be two different multisigs, each 2 of 3.
PROPOSER_MULTISIG=
GUARDIAN_MULTISIG=
# Unix time, 180 to 730 days after the deploy. 1825286400 (2027-11-03 00:00 UTC) ends with Robinhood Chain's admin term.
ADMIN_EXPIRY=1825286400
# New mainnet deployments require at least seven days (maximum thirty days).
# Admin and guardian Safes must have disjoint owners and thresholds of at least two.
TIMELOCK_DELAY=604800
# Used by the commands in BASE.md. A private endpoint holds a key, and this file is git-ignored.
RPC=https://mainnet.base.org
# The deployer's address, from the keystore in deploy/mainnet/.
DEPLOYER=
