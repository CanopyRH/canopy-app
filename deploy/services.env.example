# Copy to services.env for each process, and add the values from deploy/out/4663/services.env.
# Keep real keys in your host's secret store, not in a file. Run one ROLE per process.
ROLE=all
PORT=8443
PUBLIC_URL=https://api.example.com
# The web app that the bot's "Open Canopy" button opens. Without it the button opens PUBLIC_URL, which is the API.
APP_URL=https://app.example.com/app.html

# Require TLS and a password in production, for example ?sslmode=require
DATABASE_URL=postgres://canopy:CHANGE_ME@db.example.com:5432/canopy?sslmode=require
# Connections each service may hold. Keep services × DB_POOL × 2 (old and new copies during a deploy) under the server limit.
DB_POOL=4

CHAIN_ID=4663
# A private endpoint, such as dRPC's keyed URL. The backup must be another provider.
RPC_URL=https://lb.drpc.live/robinhood/YOUR_KEY
RPC_URL_BACKUP=https://rpc.mainnet.chain.robinhood.com

# From deploy/out/4663/services.env.
ROUTER=
ALARM_BOOK=
ADAPTER_4626=
START_BLOCK=
PLAN_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
WATCHERS=

# Use a private endpoint for mainnet. Public ones rate-limit, so the keeper could miss an exit.

# A multisig. It receives plan payments.
PLAN_PAY_ADDRESS=

# Keeper role only. It pays gas and holds no user funds.
KEEPER_PRIVATE_KEY=
KEEPER_PAID_ONLY=true
# The most gas the keeper spends on one exit from a vault that isn't in CARD_VAULTS. A costlier exit is refused, and one
# that keeps failing to move the owner's balance backs off and stops after 5 tries. Listed vaults have no such cap.
KEEPER_UNLISTED_EXIT_GAS=4000000

# Watcher role only, one key per host.
WATCHER_PRIVATE_KEY=
QUORUM=2
WATCHER_PEERS=https://watcher-a.example.com,https://watcher-b.example.com
ANTHROPIC_API_KEY=
# For PPQ. Leave both out to call Anthropic directly.
ANTHROPIC_BASE_URL=https://api.ppq.ai
CLASSIFIER_MODEL=claude-opus-5.5

# Checked 2026-11-01: each one serves RSS directly, with no redirect, and only its editors can publish. Open forums stay off this list, because a confirmed report must not be something anyone can post.
FEED_URLS=https://rekt.news/rss/feed.xml,https://cointelegraph.com/rss/tag/hacks,https://status.circle.com/history.rss,https://status.base.org/history.rss

# The vaults in web/src/config.ts, so each has a risk card before anyone arms.
CARD_VAULTS=0xBeEff033F34C046626B8D0A041844C5d1A5409dd,0xBEEff039907422219Fb367e525954DDC092854d9,0xd0dACE70434fF7567b108B5a8c2a36C150C830FE,0x8c258F25fc6fBe3f01ccC828E2C3840A46a4a9A2,0x37788ff0c1d4e45A7FE06BC7e71e0cc00121d0A8

# Public read routes allow this many requests per address per minute, then answer 429. 0 turns the limit off.
RATE_LIMIT_PER_MIN=120
# Proxies in front of the API that add to X-Forwarded-For. Railway adds one, so the client is the last entry. Set 0 if the
# API is reached directly, so a caller can't choose its own address.
TRUSTED_PROXY_HOPS=1

# Optional. Blocks a plan payment must be buried under before it is credited, and an arm before it is checked against the
# chain. Leave it out for about 10 seconds of blocks: 100 on Robinhood Chain (4663), 5 on Base (8453).
CONFIRMATIONS=

# Optional. A Telegram chat that gets operator warnings: lag, low gas, stuck exits, and every admin or guardian change
# on the contracts (AdapterSet, FeedSet, RouteSet, GuardianSet, ArmingPaused, WatcherSet). Set it before launch.
OPS_CHAT_ID=

# Optional. Turns on GET /health, with this as its bearer token. Use 16 or more random characters.
HEALTH_TOKEN=

# Only for a chain with no Canopy contracts. The contract settings above can then stay empty.
ALERTS_ONLY=false

# From @BotFather. The secret is any random string of 16 or more characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_MODE=webhook
